		{
			"name": "skill check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let res = pm.response.json();",
							"",
							"// extract actorName from the response",
							"let actorName = res.actorName;",
							"",
							"// save it as a collection variable",
							"pm.collectionVariables.set(\"favoriteActor\", actorName);",
							"",
							"// optional test just to confirm",
							"pm.test(\"favoriteActor variable is set\", function () {",
							"    pm.expect(pm.collectionVariables.get(\"favoriteActor\")).to.eql(actorName);",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "apikey",
					"apikey": [
						{
							"key": "value",
							"value": "skillcheck",
							"type": "string"
						},
						{
							"key": "key",
							"value": "student-expert",
							"type": "string"
						}
					]
				},
